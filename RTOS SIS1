/* USER CODE BEGIN Header_StartDefaultTask */
/* USER CODE END Header_StartDefaultTask */
void StartDefaultTask(void *argument)
{
  /* USER CODE BEGIN 5 */

  TickType_t lastPirActivityTick = 0;
  TickType_t lastTempSampleTick  = 0;

  const TickType_t pirPollTicks   = pdMS_TO_TICKS(PIR_POLL_MS);
  const TickType_t tempSampleTicks= pdMS_TO_TICKS(TEMP_SAMPLE_MS);
  const TickType_t inactivityTicks= pdMS_TO_TICKS(PIR_INACTIVITY_MS);

  systemActive = false;
  fanOn        = false;

  for(;;)
  {
    TickType_t now = xTaskGetTickCount();

    /* --- Leer PIR --- */
    GPIO_PinState pir = HAL_GPIO_ReadPin(PIR_GPIO_Port, PIR_Pin);
    if (pir == GPIO_PIN_SET)
    {
      systemActive        = true;
      lastPirActivityTick = now;

      /* Parpadeo rápido LED amarillo para indicar movimiento */
      HAL_GPIO_WritePin(LED_AMARILLO_GPIO_Port, LED_AMARILLO_Pin, GPIO_PIN_SET);
      osDelay(50);
      HAL_GPIO_WritePin(LED_AMARILLO_GPIO_Port, LED_AMARILLO_Pin, GPIO_PIN_RESET);
    }

    if (systemActive)
    {
      /* Sistema “despierto” → LED verde ON */
      HAL_GPIO_WritePin(LED_VERDE_GPIO_Port, LED_VERDE_Pin, GPIO_PIN_SET);

      /* --- Leer temperatura periódicamente --- */
      if ((now - lastTempSampleTick) >= tempSampleTicks)
      {
        lastTempSampleTick = now;

        if (devBME280.deviceReady)
        {
          if (BME280_ReadSensorOnce())
          {
            /* Control simple de ventilador con histéresis */
            if (!fanOn && dev.temperature >= TEMP_ON_THRESHOLD)
            {
              fanOn = true;
              HAL_GPIO_WritePin(LED_ROJO_GPIO_Port, LED_ROJO_Pin, GPIO_PIN_SET);
            }
            else if (fanOn && dev.temperature <= TEMP_OFF_THRESHOLD)
            {
              fanOn = false;
              HAL_GPIO_WritePin(LED_ROJO_GPIO_Port, LED_ROJO_Pin, GPIO_PIN_RESET);
            }
          }
        }
      }

      /* --- Inactividad: “sleep lógico” --- */
      if ((now - lastPirActivityTick) >= inactivityTicks)
      {
        systemActive = false;

        HAL_GPIO_WritePin(LED_VERDE_GPIO_Port,    LED_VERDE_Pin,    GPIO_PIN_RESET);
        HAL_GPIO_WritePin(LED_AMARILLO_GPIO_Port, LED_AMARILLO_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(LED_ROJO_GPIO_Port,     LED_ROJO_Pin,     GPIO_PIN_RESET);
        fanOn = false;
      }
    }
    else
    {
      /* Sistema inactivo: nos aseguramos de que el LED verde esté apagado */
      HAL_GPIO_WritePin(LED_VERDE_GPIO_Port, LED_VERDE_Pin, GPIO_PIN_RESET);
    }

    osDelay(pirPollTicks);
  }

  /* USER CODE END 5 */
}

